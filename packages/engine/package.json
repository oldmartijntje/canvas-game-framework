{
	"name": "canvas-game-development-framework",
	"description": "A game development framework for HTML Canvas",
	"author": "OldMartijntje",
	"license": "MIT",
	"keywords": [
		"Game Development",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/oldmartijntje/canvas-game-framework"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"browser": "./dist/index.min.js",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup",
		"test": "jest --config ./jest.config.ts",
		"test:watch": "jest --watch --config ./jest.config.ts",
		"coverage": "jest --coverage --config ./jest.config.ts",
		"lint": "biome check --config-path=../../biome.json ."
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/jquery": "^4.0.1",
		"jest": "^30.5.2",
		"ts-jest": "^29.4.15",
		"ts-node": "^10.9.2",
		"tsup": "^8.4.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"jquery": "^4.0.0"
	}
}
