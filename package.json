{
	"name": "canvas-game-framework",
	"private": true,
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"prepare": "husky",
		"dev": "npm run dev -w packages/engine & npm run dev -w examples/test-game",
		"build": "npm run build -w packages/engine",
		"build:game": "npm run build -w examples/test-game",
		"test": "npm run test -w packages/engine",
		"test:watch": "npm run test:watch -w packages/engine",
		"coverage": "npm run coverage -w packages/engine",
		"format": "biome check --fix --formatter-enabled=true --assist-enabled=true  --linter-enabled=false --config-path=biome.json  .",
		"format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false --config-path=biome.json",
		"lint": "biome check --config-path=biome.json .",
		"lint:fix": "biome lint --config-path=biome.json --write ."
	},
	"devDependencies": {
		"biome": "^0.3.3",
		"husky": "^9.1.7"
	}
}
